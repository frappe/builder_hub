       "classes": [],
       "customAttributes": {},
       "element": "p",
       "innerHTML": "Ombra started with one chair. It took eleven months, sold to a neighbour, and is still in her hallway taking compliments.",
       "mobileStyles": {},
       "rawStyles": {},
       "tabletStyles": {}
      },
      {
       "attributes": {},
       "baseStyles": {
        "color": "var(--e7a94b53-2d18-4f60-a927-8b5e3d1c4003, #837D72)",
